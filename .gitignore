# =============================================================
# .gitignore — raiz do monorepo (backend Go + frontend React)
# Regras específicas de cada subprojeto ficam em:
#   backend/.gitignore   frontend/.gitignore
# =============================================================

# -------------------------------------------------------------
# Segredos, credenciais e ambiente — NUNCA versionar
# (docs/plano.md §1 eixo 2, §10 — proibido subir .env / chaves / senhas)
# -------------------------------------------------------------
.env
.env.*
*.local
!.env.example

# Chaves SSH / TLS / certificados
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
*.ppk

# -------------------------------------------------------------
# Sistema operacional
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------------------------------------------------
# Editores / IDEs
# -------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# -------------------------------------------------------------
# Logs e artefatos locais
# -------------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak
*.orig

# -------------------------------------------------------------
# Dependências e builds (redes de segurança — cada subprojeto
# já ignora as suas; mantidas aqui contra commits acidentais)
# -------------------------------------------------------------
**/node_modules/
**/dist/
**/build/
**/coverage/

# -------------------------------------------------------------
# Documentos de planejamento (mantidos fora do versionamento)
# -------------------------------------------------------------
docs/
