# IncidentTrack — variáveis do docker-compose.
# Copie para .env (que NÃO é versionado) e ajuste.

# ---------------------------------------------------------------------
# Obrigatórias
# ---------------------------------------------------------------------

# Segredo HMAC para assinar os JWT. OBRIGATÓRIO, >= 32 bytes.
# Gere um: openssl rand -base64 48
JWT_SECRET=

# Porta do host onde a aplicação fica acessível.
APP_PORT=8080

# URL pela qual o navegador acessa a aplicação. Precisa bater com APP_PORT.
# Local:     http://localhost:8080   (se APP_PORT=3000 → http://localhost:3000)
# Produção:  https://<IP_PUBLICO_DA_VM>
APP_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------
# Produção (deixe comentado para desenvolvimento local sobre HTTP)
# ---------------------------------------------------------------------

# Em produção o backend roda em modo estrito e EXIGE COOKIE_SECURE=true.
# APP_ENV=production
# COOKIE_SECURE=true

# true só quando a API está atrás de um proxy reverso confiável (é o caso:
# Nginx do serviço "web" + Nginx do host com Certbot). Default já é true.
# TRUST_PROXY=true
