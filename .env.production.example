# IncidentTrack — modelo de .env para PRODUÇÃO (VM atrás de HTTPS).
#
# Copie para .env na VM (NUNCA versione o .env real) OU use estes campos
# como referência para os GitHub Secrets consumidos por
# .github/workflows/deploy.yml (que gera este arquivo automaticamente).
#
#   cp .env.production.example .env
#   # preencha JWT_SECRET, APP_ORIGIN e APP_PORT

# Modo estrito: o backend recusa subir sem COOKIE_SECURE=true.
APP_ENV=production

# Cookie de sessão só sobre HTTPS. Obrigatório true em produção.
COOKIE_SECURE=true

# Segredo HMAC dos JWT. OBRIGATÓRIO, >= 32 bytes, EXCLUSIVO de produção
# (não reutilize o de desenvolvimento). Gere com:
#   openssl rand -base64 48
JWT_SECRET=

# Porta pública onde o Nginx do host encaminha para a stack.
APP_PORT=8080

# URL exata pela qual o navegador acessa a aplicação (usada também no
# CORS de origem única). Certificado Let's Encrypt para IP público:
#   https://<IP_PUBLICO_DA_VM>
APP_ORIGIN=https://SEU_IP_PUBLICO

# Opcional: a API já roda atrás do Nginx do serviço "web" + Nginx do
# host, então confiar no X-Forwarded-For é o correto (default já é true
# quando APP_ENV=production).
# TRUST_PROXY=true
