# IncidentTrack — backend
# Copie para .env e ajuste. NUNCA versione o .env real (está no .gitignore).

# Ambiente: development | production
APP_ENV=development

# Endereço de escuta do servidor HTTP
HTTP_ADDR=:8080

# Caminho do arquivo SQLite (o diretório é criado automaticamente)
DATABASE_URL=file:data/incidenttrack.db

# Segredo HMAC para assinar os JWT. OBRIGATÓRIO. Mínimo 32 bytes.
# Gere um novo com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-bytes

# Validade do token de sessão (curta, docs/plano.md §5)
ACCESS_TOKEN_TTL=15m

# Cookie de sessão
COOKIE_NAME=it_session
# Em produção DEVE ser true (cookie só sobre HTTPS). Em dev local sobre
# HTTP, defina false.
COOKIE_SECURE=false
# Deixe vazio para o browser inferir o host atual
COOKIE_DOMAIN=

# Origem EXATA do frontend autorizada no CORS (nunca "*")
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Confiar em X-Forwarded-For / X-Real-IP para identificar o IP do cliente.
# true SOMENTE atrás de um proxy reverso confiável (Nginx, ou o serviço
# "web" do docker-compose). Default: true quando APP_ENV=production.
TRUST_PROXY=false

# Rate limiting de login por IP (força bruta — docs/plano.md §5)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m

# Teto global de requisições por IP
API_RATE_LIMIT=120
API_RATE_WINDOW=1m

# Custo do bcrypt (10..15). 12 é o valor do plano.
BCRYPT_COST=12

# Timeouts do servidor HTTP
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
