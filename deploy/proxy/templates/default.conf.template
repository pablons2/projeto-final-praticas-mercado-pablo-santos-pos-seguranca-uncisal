# Proxy TLS de produção — termina HTTPS (com key exchange pós-quântico) e
# encaminha para o contêiner "web" (SPA + /api). Usado só pelo override
# docker-compose.prod.yml.
#
# ${CERT_NAME} é substituído pelo entrypoint do nginx (envsubst) a partir
# da variável de ambiente CERT_NAME — normalmente o IP público da VM,
# nome da lineage criada por `certbot certonly --ip-address <IP>`.
# As variáveis nginx ($host, $remote_addr, ...) NÃO são tocadas
# (NGINX_ENVSUBST_FILTER=CERT_NAME no compose).

server {
    listen 80;
    listen [::]:80;
    server_name _;

    server_tokens off;

    # Desafio ACME (renovação do certificado via webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo o resto: redireciona para HTTPS (Eixo 1 — HTTP->HTTPS).
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;

    ssl_protocols TLSv1.3 TLSv1.2;

    # Key exchange híbrido pós-quântico primeiro, clássicos como fallback.
    # Requer nginx compilado com OpenSSL >= 3.5 (imagem nginx:1.29-alpine).
    # Se a build não reconhecer o nome híbrido aqui, troque por:
    #   ssl_conf_command Groups X25519MLKEM768:X25519:secp256r1;
    ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1;
    ssl_prefer_server_ciphers off;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Corpo máximo alinhado ao limite do backend.
    client_max_body_size 1m;

    location / {
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
